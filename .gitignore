__pycache__/
*.pyc
*.i64
*.idb
*.tmp
scratch/**/*.json.tmp

# Windows reserved device names accidentally created by shell redirects
nul
con
prn
aux

# Z: 游戏库本地镜像(司令部一次性拷贝,大数据不入库)
scratch/data/

# 子代理派生大缓存(pkl/npy 中间产物,可由脚本复算,不入仓)
scratch/**/*.pkl
scratch/**/*.npy

# 重度生成数据(探针输出可复算;cup-prize 为外部编辑器 XML,非本使命产物)
scratch/t05/people/
scratch/t05/team_comp/
scratch/cup-prize-0362/
# 解码载荷复算产物(t71 起),可由脚本重生成,不入仓
scratch/**/*.bin
scratch/t90/out/schema_v112.json
